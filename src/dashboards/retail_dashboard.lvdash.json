{
  "datasets": [
    {
      "name": "ds_region",
      "displayName": "Revenue by region",
      "queryLines": [
        "SELECT region, revenue, order_count, customer_count, avg_order_value, published_at\n",
        "FROM region_metrics"
      ]
    },
    {
      "name": "ds_category",
      "displayName": "Revenue by category",
      "queryLines": [
        "SELECT category, revenue, units, order_count\n",
        "FROM category_revenue"
      ]
    },
    {
      "name": "ds_top_customers",
      "displayName": "Top customers",
      "queryLines": [
        "SELECT revenue_rank, customer_id, customer_name, region, segment, order_count, revenue\n",
        "FROM customer_metrics\n",
        "WHERE revenue_rank <= 10\n",
        "ORDER BY revenue_rank"
      ]
    },
    {
      "name": "ds_audit",
      "displayName": "Latest audit status",
      "queryLines": [
        "SELECT check_name, status, metric_value, detail, run_id, recorded_at\n",
        "FROM latest_audit_status\n",
        "ORDER BY recorded_at DESC"
      ]
    }
  ],
